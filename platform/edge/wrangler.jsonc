{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "partii-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "Session" },
      { "name": "ROOM", "class_name": "Room" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session", "Room"] }],
  "vars": {
    "PARTII_ENV": "dev",
    "KEY_SECRET": "dev-only-key-secret",
    "TURN_MODE": "none",
    "ADMIN_TOKEN": "dev-admin-token",
    "PLAYER_TOKEN_SECRET": "dev-only-player-secret",
    "ALLOW_FAKE_LOGIN": "1",
    "ALLOW_FAKE_STORE": "1",
    "EMAIL_MODE": "dev"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "partii-dev", "database_id": "local-dev", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "partii-dev-files" }],
  "kv_namespaces": [{ "binding": "FILES_KV", "id": "local-files-kv" }],
  "env": {
    "staging": {
      "name": "partii-edge-staging",
      "vars": { "PARTII_ENV": "staging", "TURN_MODE": "cloudflare", "ALLOW_FAKE_LOGIN": "1", "ALLOW_FAKE_STORE": "1", "EMAIL_MODE": "dev", "STORE_URL": "https://partii-store-staging.partii-games.workers.dev" },
      "durable_objects": {
        "bindings": [
          { "name": "SESSION", "class_name": "Session" },
          { "name": "ROOM", "class_name": "Room" }
        ]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session", "Room"] }],
      // Files live in KV until R2 is enabled on the account (then bind FILES).
      "d1_databases": [{ "binding": "DB", "database_name": "partii-staging", "database_id": "ae121fa6-576a-4a8f-899b-44f7049ee6a2", "migrations_dir": "migrations" }],
      "kv_namespaces": [{ "binding": "FILES_KV", "id": "e6275db98929438d87f10f3fde91a799" }]
    }
  }
}
