{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "partii-edge",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [
      { "name": "SESSION", "class_name": "Session" },
      { "name": "ROOM", "class_name": "Room" },
      { "name": "USAGE", "class_name": "Usage" },
          { "name": "LIMITER", "class_name": "Limiter" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session", "Room"] }, { "tag": "v2", "new_sqlite_classes": ["Usage"] }, { "tag": "v3", "new_sqlite_classes": ["Limiter"] }],
  // Logs kept in the dashboard (Workers Logs): usage alerts are logged there.
  "observability": { "enabled": true },
  "vars": {
    "PARTII_ENV": "dev",
    "KEY_SECRET": "dev-only-key-secret",
    "UGC": "on",
    "UGC_SIGNIN": "on",
    // Dev only; staging and production set SECRETS_KEY as a secret.
    "SECRETS_KEY": "ZGV2LW9ubHktc2VjcmV0cy1rZXktMzItYnl0ZXMhISE",
    "TURN_MODE": "none",
    "ADMIN_TOKEN": "dev-admin-token", "MODERATOR_TOKEN": "dev-moderator-token", "WEB_DOMAIN": ".localhost",
    "PLAYER_TOKEN_SECRET": "dev-only-player-secret",
    "ALLOW_FAKE_LOGIN": "1",
    "ALLOW_FAKE_STORE": "1",
    "EMAIL_MODE": "dev"
  },
  "d1_databases": [{ "binding": "DB", "database_name": "partii-dev", "database_id": "local-dev", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "partii-dev-files" }],
  "kv_namespaces": [{ "binding": "FILES_KV", "id": "local-files-kv" }],
  "env": {
    "staging": {
      "name": "partii-edge-staging",
      // The workers.dev host stays on: shipped games use it.
      "workers_dev": true,
      "routes": [{ "pattern": "api-staging.partii.games", "custom_domain": true }, { "pattern": "*-staging.partii.games/*", "zone_name": "partii.games" }],
      "vars": { "PARTII_ENV": "staging", "RATE_LIMITS": "on", "TURN_MODE": "cloudflare", "ALLOW_FAKE_LOGIN": "1", "ALLOW_FAKE_STORE": "1", "EMAIL_MODE": "dev", "STORE_URL": "https://partii-store.vercel.app", "R2_BUCKET": "partii-staging-files", "UGC": "on", "UGC_SIGNIN": "on", "WEB_DOMAIN": "-staging.partii.games", "APPLE_CLIENT_IDS": "me.sterlinglong.tankii" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "durable_objects": {
        "bindings": [
          { "name": "SESSION", "class_name": "Session" },
          { "name": "ROOM", "class_name": "Room" },
          { "name": "USAGE", "class_name": "Usage" },
          { "name": "LIMITER", "class_name": "Limiter" }
        ]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session", "Room"] }, { "tag": "v2", "new_sqlite_classes": ["Usage"] }, { "tag": "v3", "new_sqlite_classes": ["Limiter"] }],
      // Files: R2 (FILES). The KV namespace stays bound only as the old copy
      // (migrated to R2 on 2026-10-11); files() uses R2 when it is bound.
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "partii-staging-files" }],
      "d1_databases": [{ "binding": "DB", "database_name": "partii-staging", "database_id": "ae121fa6-576a-4a8f-899b-44f7049ee6a2", "migrations_dir": "migrations" }],
      "kv_namespaces": [{ "binding": "FILES_KV", "id": "e6275db98929438d87f10f3fde91a799" }]
    },
    "production": {
      "name": "partii-edge",
      // The workers.dev host stays on: shipped games use it.
      "workers_dev": true,
      "routes": [{ "pattern": "api.partii.games", "custom_domain": true }, { "pattern": "*.partii.games/*", "zone_name": "partii.games" }],
      "vars": { "PARTII_ENV": "production", "RATE_LIMITS": "on", "TURN_MODE": "cloudflare", "EMAIL_MODE": "resend", "STORE_URL": "https://partii.games", "R2_BUCKET": "partii-prod-files", "UGC": "on", "UGC_SIGNIN": "on", "WEB_DOMAIN": ".partii.games", "APPLE_CLIENT_IDS": "me.sterlinglong.tankii" },
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      "durable_objects": {
        "bindings": [
          { "name": "SESSION", "class_name": "Session" },
          { "name": "ROOM", "class_name": "Room" },
          { "name": "USAGE", "class_name": "Usage" },
          { "name": "LIMITER", "class_name": "Limiter" }
        ]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Session", "Room"] }, { "tag": "v2", "new_sqlite_classes": ["Usage"] }, { "tag": "v3", "new_sqlite_classes": ["Limiter"] }],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "partii-prod-files" }],
      "d1_databases": [{ "binding": "DB", "database_name": "partii-prod", "database_id": "6732f165-1ebd-47e4-9256-5e3f9e921054", "migrations_dir": "migrations" }],
      "kv_namespaces": [{ "binding": "FILES_KV", "id": "89eb23fc19534e979fcfa488edcdabdb" }]
    }
  }
}
