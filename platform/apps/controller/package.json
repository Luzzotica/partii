{
  "name": "partii-controller",
  "private": true,
  "type": "module",
  "scripts": {
    "engine": "mkdir -p public/engine && cp ../../sdk/engine-web/partii_engine.js ../../sdk/engine-web/partii_engine_bg.wasm public/engine/",
    "dev": "npm run engine && vite",
    "build": "npm run engine && tsc --noEmit && vite build",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "test": "node test/e2e.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "playwright": "^1.56.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "wrangler": "^4.149.0"
  }
}
